<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hils_bridge_actuator_orientalmotor_id_share</name>
  <version>0.1.0</version>
  <description>HILS bridge: emulates OrientalMotor BLV-R / AZ series ID-share Modbus RTU motor slaves on a serial bus, converting the controller's drive commands to JointState topics and simulator feedback to motor replies</description>
  <maintainer email="hijimasa@gmail.com">Masaaki Hijikata</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>hils_bridge_base</depend>
  <exec_depend>python3-serial</exec_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
